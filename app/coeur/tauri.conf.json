{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BreezyShot",
  "mainBinaryName": "breezyshot",
  "version": "0.6.0",
  "identifier": "dev.breezyshot.desktop",
  "build": {
    "frontendDist": "../interface"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/breezyshot.ico", "icons/breezyshot.png"]
  }
}
